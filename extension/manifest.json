{
  "manifest_version": 3,
  "name": "Gerador de Orçamentos Coktelitas",
  "version": "1.1.0",
  "description": "Acesso rápido ao Gerador de Orçamentos da Coktelitas pela barra do Chrome.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gerador de Orçamentos Coktelitas",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}